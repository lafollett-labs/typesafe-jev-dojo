# With NO Jev key set, `npm run demo` runs in SIM mode (badged). With a key it goes LIVE.
# Transport preference: native TypeSafe → OpenRouter → SIM.

# Native TypeSafe — authoritative schema. PRIMARY. https://console.typesafe.ai
TYPESAFE_API_KEY=

# OpenRouter — alternate Jev transport (used only if TYPESAFE_API_KEY is empty).
OPENROUTER_API_KEY=

# Optional Jev model override (native default: jev-latest · OpenRouter: typesafe/jev-1.13)
# JEV_MODEL=jev-latest

# Claude = the Gauntlet's LLM opponent — ALWAYS via your SUBSCRIPTION, never a metered key.
#   1) run:  claude setup-token    2) paste the token below    3) npm i @anthropic-ai/claude-agent-sdk
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_MODEL=claude-haiku-4-5

# PORT=5178
